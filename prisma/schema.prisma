generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String?
  passwordHash  String?
  avatarUrl     String?
  kycStatus     KycStatus @default(PENDING)
  role          Role     @default(MERCHANT)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products     Product[]
  charges      Charge[]
  transactions Transaction[]
  withdrawals  Withdrawal[]
  apiKeys      ApiKey[]
  webhooks     Webhook[]

  @@index([email])
  @@index([role])
  @@index([kycStatus])
}

model Product {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Decimal
  category    String?
  isActive    Boolean  @default(true)
  qrCodeData  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  charges Charge[]

  @@index([userId])
  @@index([isActive])
  @@index([category])
}

model Charge {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId            String?
  product              Product? @relation(fields: [productId], references: [id])
  amount               Decimal
  pixKey               String
  status               ChargeStatus @default(PENDING)
  openpixTransactionId String?
  qrCodeUrl            String?
  expiresAt            DateTime
  createdAt            DateTime @default(now())
  completedAt          DateTime?

  transactions Transaction[]

  @@index([userId])
  @@index([status])
  @@index([productId])
  @@index([expiresAt])
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chargeId    String?
  charge      Charge?  @relation(fields: [chargeId], references: [id])
  type        TransactionType
  method      PaymentMethod @default(PIX)
  amount      Decimal
  status      TransactionStatus @default(PENDING)
  provider    String   @default("openpix")
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([chargeId])
  @@index([createdAt])
}

model Withdrawal {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount          Decimal
  pixKey          String
  status          WithdrawalStatus @default(PROCESSING)
  transactionId   String?
  transaction     Transaction? @relation(fields: [transactionId], references: [id])
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  @@index([userId])
  @@index([status])
  @@index([transactionId])
}

model Provider {
  id          String   @id @default(uuid())
  name        String
  apiKey      String
  baseUrl     String
  status      ProviderStatus @default(ACTIVE)
  priority    Int
  feePercent  Decimal
  config      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([status])
}

model ApiKey {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyHash     String
  name        String
  permissions Json
  lastUsedAt  DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([keyHash])
  @@index([isActive])
}

model Webhook {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url         String
  secret      String
  events      Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([userId])
  @@index([url])
}

model WebhookDelivery {
  id          String   @id @default(uuid())
  webhookId   String
  webhook     Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  payload     Json
  status      DeliveryStatus @default(PENDING)
  response    String?
  attempts    Int      @default(0)
  nextRetryAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([webhookId])
  @@index([status])
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum Role {
  MERCHANT
  ADMIN
}

enum ChargeStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  BOLETO
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum WithdrawalStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum ProviderStatus {
  ACTIVE
  INACTIVE
  DEGRADED
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}